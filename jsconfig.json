{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "jsx": "preserve",
    "types": [
      "utools-api-types"
    ]
  },
  "vueCompilerOptions": {
    "target": 3,
    "globalTypesPath": "./.volar/vue-global.d.ts"
  },
  "include": [
    "src/**/*.vue",
    "src/**/*.js",
    "src/**/*.ts"
  ]
}
