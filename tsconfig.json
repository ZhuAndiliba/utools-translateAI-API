{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["utools-api-types"]
  },
  "vueCompilerOptions": {
    "target": 3,
    "globalTypesPath": "./.volar/vue-global.d.ts"
  },
  "include": ["src/**/*.vue", "src/**/*.js", "src/**/*.ts"]
}
